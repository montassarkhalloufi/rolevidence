# Local server configuration. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Local Express port (default: 3001)
PORT=3001

# Optional second provider. Only these explicitly configured models are offered.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local SQLite file. Keep it in an ignored private directory.
DATABASE_PATH=storage/rolevidence.sqlite

# Optional content-free technical telemetry. Never enable automatic SDK tracing.
ROLEVIDENCE_TELEMETRY=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rolevidence-local
