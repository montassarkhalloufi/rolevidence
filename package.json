{
  "name": "rolevidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env --watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "test": "node --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eval:semantics": "node --env-file-if-exists=.env scripts/eval-semantics.ts",
    "lint": "eslint src scripts tests",
    "architecture": "node scripts/check-architecture.ts",
    "api:generate": "node scripts/generate-openapi.ts",
    "api:check": "node scripts/generate-openapi.ts --check",
    "test:ui": "vitest run --config vitest.config.ts",
    "quality": "npm run check && npm run lint && npm run architecture && npm run api:check && npm run format:check && npm test && npm run test:ui && npm run build",
    "eval:heldout": "node --env-file-if-exists=.env scripts/eval-semantics.ts --held-out",
    "lint:fix": "eslint src scripts tests --fix",
    "eval:acceptance": "node --env-file-if-exists=.env scripts/eval-semantics.ts --acceptance",
    "eval:api": "node scripts/eval-api.ts",
    "eval:api-contract": "node scripts/eval-api-contract.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "5.2.1",
    "mammoth": "1.12.2",
    "multer": "2.3.0",
    "openai": "7.14.0",
    "pdf-parse": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT",
  "description": "Local evidence-based profile and job comparison for job seekers and recruiters",
  "repository": {
    "type": "git",
    "url": "https://github.com/montassarkhalloufi/rolevidence.git"
  },
  "bugs": {
    "url": "https://github.com/montassarkhalloufi/rolevidence/issues"
  },
  "homepage": "https://github.com/montassarkhalloufi/rolevidence#readme"
}
