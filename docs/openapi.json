                          ]
                        },
                        "relation": {
                          "type": "string",
                          "enum": [
                            "equivalence",
                            "indirect_evidence",
                            "contradiction",
                            "insufficient_information"
                          ]
                        },
                        "justification": {
                          "type": "string",
                          "description": "Explique pourquoi la pratique répond ou non à cette exigence précise, en distinguant niveau et contexte."
                        }
                      },
                      "required": [
                        "describedPractice",
                        "relation",
                        "justification"
                      ],
                      "additionalProperties": false
                    },
                    "evidenceState": {
                      "type": "string",
                      "enum": [
                        "supported",
                        "contradicted",
                        "insufficient_information"
                      ]
                    },
                    "verification": {
                      "anyOf": [
